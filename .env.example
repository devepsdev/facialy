# ── Obligatorias ────────────────────────────────────────────────
SECRET_KEY=cambia-esto-por-una-clave-aleatoria-de-50-caracteres
DB_NAME=facialy
DB_USER=facialy_user
DB_PASSWORD=cambia_esta_password
DB_HOST=db

# ── Superadmin inicial (opcional) ───────────────────────────────
# Si defines ADMIN_PASSWORD, el contenedor crea/actualiza este superadmin al arrancar.
# Para añadir cuentas con otros roles: scripts/add-admin.ps1 | scripts/add-admin.sh
ADMIN_USER=admin
ADMIN_PASSWORD=

# ── Demo público (opcional) ─────────────────────────────────────
# Permite entrar como "invitado" (solo lectura) y rellena datos de ejemplo.
GUEST_LOGIN_ENABLED=false
SEED_DEMO=false
# Registro público de usuarios (cuentas pendientes de aprobación)
REGISTRATION_ENABLED=true

# ── Ajustes (valores por defecto) ───────────────────────────────
# DEBUG=false
# ALLOWED_HOSTS=localhost,127.0.0.1,deveps.ddns.net
# CSRF_TRUSTED_ORIGINS=https://deveps.ddns.net
# TIME_ZONE=Europe/Madrid
# FACE_MATCH_THRESHOLD=0.40          # similitud coseno mínima (0-1); súbela para ser más estricto
# ACCESS_SCHEDULE_GRACE_MINUTES=30   # margen alrededor del horario del empleado
# ACCESS_LOG_COOLDOWN_SECONDS=30     # anti-duplicados del kiosco
# JWT_ACCESS_MINUTES=15              # vida del access token
# JWT_REFRESH_DAYS=7                 # vida del refresh token (cookie httpOnly)
# SECURE_COOKIES=true                # pon false solo en http://localhost
# LOGIN_MAX_FAILURES=5               # bloqueo temporal de la cuenta tras N fallos
